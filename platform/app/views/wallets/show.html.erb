<% content_for :title, "Payout wallet" %>
<% active = current_user.active_wallet %>

<div class="wrap screen page-narrow">
  <%= link_to dashboard_path, class: "link link-muted", style: "margin-bottom: 20px" do %>
    <span style="transform: rotate(180deg); display: inline-flex"><%= icon(:arrow, 14) %></span> Dashboard
  <% end %>

  <h1 class="h-page" style="margin-top: 20px">Payout wallet</h1>
  <p class="sub" style="max-width: 540px">
    The address bounties you earn are paid to. It's used at merge time — whatever is active
    when a PR merges is where the USDC goes. Double-check it: a wrong address is irreversible,
    and it's your assertion, not ours.
  </p>

  <% if active %>
    <div class="card card-pad" style="margin-top: 24px; padding: 18px; background: var(--card-2)">
      <div style="display: flex; align-items: center; gap: 14px">
        <span class="icon-box icon-box-orange"><%= icon(:wallet, 18) %></span>
        <div style="min-width: 0; flex: 1">
          <div class="eyebrow" style="margin-bottom: 5px">Current active wallet</div>
          <div style="font-size: 14px" class="truncate"><%= active.address %></div>
        </div>
        <span class="badge badge-paid" style="gap: 6px"><span style="width: 6px; height: 6px; border-radius: 50%; background: var(--green)"></span>Active</span>
      </div>
    </div>
  <% end %>

  <div class="card card-pad" style="margin-top: 16px">
    <%= form_with url: wallet_path, method: :post do |f| %>
      <div class="field" style="margin-bottom: 0">
        <label class="label"><%= active ? "Replace payout wallet" : "Link a payout wallet" %></label>
        <%= f.text_field "wallet_link[address]", value: nil, placeholder: "0x…", spellcheck: false, autocomplete: "off", class: "input" %>
        <div class="hint">Paste an Ethereum address that can receive USDC on Base.</div>
      </div>
      <div style="margin-top: 18px">
        <%= f.submit "Link wallet", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <p class="hint" style="margin-top: 14px">Make sure this wallet can receive USDC on Base.</p>
</div>
