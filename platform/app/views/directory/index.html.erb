<% content_for :title, "Open bounties" %>

<div class="wrap screen page">
  <div style="margin-bottom: 24px; max-width: 560px">
    <h1 class="h-page">Open bounties</h1>
    <p class="sub">Funded issues across every repo using GitReward. Solve one, link a wallet, get paid on merge.</p>
  </div>

  <% if @bounties.any? %>
    <div class="bounty-grid">
      <% @bounties.each do |b| %>
        <%= link_to b, class: "card card-pad bounty" do %>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px">
            <span style="display: inline-flex; align-items: center; gap: 8px; color: var(--tx-2); font-size: 13.5px; min-width: 0">
              <span style="color: var(--tx-3); flex-shrink: 0; display: inline-flex"><%= icon(:repo, 16) %></span>
              <span class="truncate"><%= b.repository.full_name %></span>
            </span>
            <%= render "bounties/status_badge", bounty: b %>
          </div>
          <h3 style="margin: 0 0 18px; font-size: 15.5px; font-weight: 600; line-height: 1.4; letter-spacing: -0.01em">Issue #<%= b.github_issue_number %></h3>
          <div class="eyebrow" style="margin-bottom: 6px">Reward</div>
          <span class="amount accent" style="font-size: 24px"><%= b.amount_usdc %><span class="unit">USDC</span></span>
          <hr class="divider" style="margin: 16px 0 13px">
          <div style="display: flex; justify-content: space-between; align-items: center">
            <span style="color: var(--tx-3); font-size: 12.5px">Expires <%= b.expiry&.to_date %> · <%= b.target_branch %></span>
            <span class="link" style="font-size: 13px">View <%= icon(:arrow, 13) %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <div class="empty-icon"><%= gitreward_logo(28) %></div>
      <h2 class="h-sec" style="font-size: 17px">No open bounties just yet</h2>
      <p class="sub" style="margin-top: 8px">This is where funded GitHub issues show up — fund one and contributors can find it here. Maintainers: bounty an issue from your dashboard.</p>
      <div style="margin-top: 20px">
        <% if signed_in? %>
          <%= link_to "Fund an issue", dashboard_path, class: "btn btn-primary btn-sm" %>
        <% else %>
          <%= button_to github_auth_path, method: :post, data: { turbo: false }, class: "btn btn-primary btn-sm" do %>Sign in to fund an issue<% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
