<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "GitReward" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="GitReward">
    <meta name="theme-color" content="#09090B">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="shell">
    <% if beta_host? %>
      <div class="beta-banner" role="status">
        <span class="beta-dot" aria-hidden="true"></span>
        <span class="beta-tag">Beta</span>
        <span class="beta-msg">
          <% if current_page?(root_path) %>
            The <strong><%= Chain::Config.chain_label %> testnet</strong> is live — try it with test USDC.
          <% else %>
            You're on the <strong><%= Chain::Config.chain_label %> testnet</strong>.
          <% end %>
        </span>
      </div>
    <% end %>

    <nav class="nav">
      <div class="wrap nav-inner">
        <%= link_to root_path, class: "brand" do %>
          <%= gitreward_logo(26) %>
          <span class="brand-name">GitReward</span>
        <% end %>
        <div class="nav-spacer"></div>
        <% if signed_in? %>
          <%= link_to root_path, class: "user" do %>
            <% if current_user.github_avatar_url.present? %>
              <%= image_tag current_user.github_avatar_url, class: "avatar", alt: "" %>
            <% else %>
              <span class="avatar"><%= current_user.github_login.to_s.first&.upcase %></span>
            <% end %>
            <span class="user-handle"><%= current_user.github_login %></span>
          <% end %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "signout" %>
        <% else %>
          <%= button_to github_auth_path, method: :post, data: { turbo: false }, class: "btn btn-primary btn-sm" do %>
            Sign in with GitHub
          <% end %>
        <% end %>
      </div>
    </nav>

    <% if notice || alert %>
      <div class="wrap" style="padding-top:16px">
        <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
        <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
