<% content_for :title, "Fund a bounty" %>

<div class="wrap screen page-wide"
  data-controller="wallet"
  data-wallet-chain-id-value="<%= Chain::Config.chain_id %>"
  data-wallet-chain-name-value="<%= Chain::Config.chain_label %>"
  data-wallet-rpc-url-value="<%= Chain::Config.public_rpc_url %>"
  data-wallet-escrow-value="<%= Chain::Config.escrow_address %>"
  data-wallet-usdc-value="<%= Chain::Config.usdc_address %>"
  data-wallet-usdc-version-value="<%= Chain::Config.usdc_permit_version %>"
  data-wallet-fee-bps-value="<%= @fee_bps %>"
  data-wallet-create-url-value="<%= bounties_path %>"
  data-wallet-repository-id-value="<%= @repository.id %>"
  data-wallet-csrf-value="<%= form_authenticity_token %>">

  <%= link_to dashboard_path, class: "link link-muted", style: "margin-bottom: 20px" do %>
    <span style="transform: rotate(180deg); display: inline-flex"><%= icon(:arrow, 14) %></span> Dashboard
  <% end %>

  <h1 class="h-page" style="margin-top: 20px">Fund a bounty</h1>
  <p class="sub" style="display: inline-flex; align-items: center; gap: 8px">
    <span style="color: var(--tx-3); display: inline-flex"><%= icon(:repo, 16) %></span><%= @repository.full_name %>
  </p>

  <% unless Chain::Config.escrow_configured? %>
    <div class="flash flash-alert" style="margin-top: 16px">The escrow contract isn't configured for this network yet, so funding is disabled.</div>
  <% end %>

  <div class="fund-grid" style="margin-top: 24px">
    <%# Left: bounty details %>
    <div class="card card-pad" style="padding: 24px">
      <div class="card-head">
        <h3 class="h-sec">Bounty details</h3>
        <p class="card-desc">Define the issue and reward. Funds release automatically on merge.</p>
      </div>

      <div class="field">
        <label class="label">Issue</label>
        <% if @issues.any? %>
          <select class="select" data-wallet-target="issue">
            <% @issues.each do |i| %>
              <option value="<%= i[:number] %>" data-node-id="<%= i[:node_id] %>" data-issue-ref="<%= i[:issue_ref] %>" <%= "disabled" if i[:has_active_bounty] %>>
                #<%= i[:number] %> — <%= truncate(i[:title], length: 56) %><%= " (already funded)" if i[:has_active_bounty] %>
              </option>
            <% end %>
          </select>
        <% else %>
          <p class="hint">No open issues found (or the GitHub App can't read them yet).</p>
        <% end %>
      </div>

      <div class="field">
        <label class="label">Target branch</label>
        <input class="input" type="text" data-wallet-target="branch" value="<%= @repository.default_branch %>">
        <div class="hint">The PR must merge into this branch to disburse the escrow.</div>
      </div>

      <div class="grid-2" style="gap: 16px">
        <div class="field" style="margin-bottom: 0">
          <label class="label">Amount (USDC)</label>
          <input class="input" type="number" min="<%= @min_usdc %>" step="0.01" value="50"
                 data-wallet-target="amount" data-action="input->wallet#recalc">
          <div class="hint">Minimum <%= @min_usdc %> USDC.</div>
        </div>
        <div class="field" style="margin-bottom: 0">
          <label class="label">Expires in (days)</label>
          <input class="input" type="number" min="7" value="<%= @default_expiry_days %>" data-wallet-target="expiry">
          <div class="hint">Minimum 7 days.</div>
        </div>
      </div>
    </div>

    <%# Right: escrow summary %>
    <div class="card card-pad">
      <div class="card-head">
        <h3 class="h-sec">Escrow summary</h3>
        <p class="card-desc">Review before you sign.</p>
      </div>
      <div class="kv" style="padding: 12px 0"><span class="kv-k">Bounty locked</span><span class="kv-v" data-wallet-target="lockedOut">—</span></div>
      <div class="kv" style="padding: 12px 0"><span class="kv-k">Platform fee · <span data-wallet-target="feeLabel"><%= @fee_bps / 100.0 %></span>%</span><span class="kv-v" data-wallet-target="feeOut">—</span></div>
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0 18px">
        <div>
          <div style="font-weight: 500; font-size: 14px">Solver receives</div>
          <div class="hint" style="margin-top: 2px"><%= 100 - @fee_bps / 100.0 %>% on merge</div>
        </div>
        <span class="amount accent" style="font-size: 20px"><span data-wallet-target="netOut">—</span><span class="unit">USDC</span></span>
      </div>

      <button type="button" class="btn btn-primary btn-block" data-wallet-target="submit"
              data-action="wallet#fund" <%= "disabled" unless Chain::Config.escrow_configured? %>>
        <%= icon(:wallet, 16) %> Connect wallet &amp; fund
      </button>
      <p data-wallet-target="status" class="hint" style="margin-top: 10px; min-height: 1em"></p>

      <div class="hint" style="margin-top: 10px">
        You'll sign two things: a gasless USDC permit (authorizing the escrow to pull the funds)
        and the fund transaction itself (you pay only its gas). The USDC then sits in the
        open-source escrow until the issue's PR merges, or until you refund after expiry.
      </div>
    </div>
  </div>
</div>
