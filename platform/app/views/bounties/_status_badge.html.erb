<%#
  Maps our Bounty statuses to the design-system badge styles:
    funded → orange "Funded", disbursed → green "Paid out",
    refunded → muted "Refunded", pending → amber "Pending".
%>
<% klass, label = {
     "funded"    => ["badge-funded", "Funded"],
     "disbursed" => ["badge-paid",   "Paid out"],
     "refunded"  => ["badge-open",   "Refunded"],
     "pending"   => ["badge-pending","Pending"]
   }[bounty.status] || ["badge-open", bounty.status.to_s.capitalize] %>
<span class="badge <%= klass %>"><%= label %></span>
